# Neon Postgres connection string (found in Neon dashboard)
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Cloudflare R2 (S3-compatible) for photo storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=fit-for-75
# Public base URL for the bucket (R2.dev public URL or your custom domain, no trailing slash)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Simple passcode gate. Leave unset to disable auth (e.g. local dev).
APP_PASSCODE=changeme
